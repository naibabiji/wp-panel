name = "wp-panel-stats"
main = "index.js"
compatibility_date = "2025-01-01"

# Worker 接收面板匿名心跳上报，并提供公开统计 API。
# 部署前需要先创建 KV namespace：
#   npx wrangler kv namespace create "STATS_KV"
# 然后把输出的 id 填入下方双引号内。

[[kv_namespaces]]
binding = "STATS_KV"
id = "YOUR_KV_NAMESPACE_ID"
preview_id = "YOUR_KV_NAMESPACE_ID"

# 每 6 小时刷新一次；刷新失败时 KV 中的最后有效快照不会被覆盖。
[triggers]
crons = ["17 */6 * * *"]
